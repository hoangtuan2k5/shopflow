# Customer-auth example: add to your existing local/private env; never overwrite production env.
RESEND_API_KEY=
MAIL_FROM='ShopFlow <shopflow@hoangtuan.dev>'

# Independent Base64 secret: at least 32 random bytes; never reuse provider keys.
OTP_HMAC_SECRET=

# Google Web OAuth client; backend only. Leave both empty to disable Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
