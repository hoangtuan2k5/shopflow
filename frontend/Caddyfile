shopflow.hoangtuan.dev, shopflow.phamthuy.dev {
	root * /srv
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy backend:8080 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
			header_up -Forwarded
			header_up -X-Forwarded-Prefix
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

wnc.phamthuy.dev {
	reverse_proxy 172.20.0.1:5001
}

wnc.hoangtuan.dev {
	reverse_proxy 172.20.0.1:5002
}
